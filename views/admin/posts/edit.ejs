<%- include('../../partials/header') %>
<div class="admin-header">
    <span>LOGGED IN AS: <%= user %></span>
    <nav>
        <a href="/admin">DASHBOARD</a> | <a href="/admin/posts">POSTS</a> | <a href="/admin/categories">CATEGORIES</a> | <a href="/admin/tags">TAGS</a> | <a href="/admin/pages">PAGES</a> | <a href="/admin/comments">COMMENTS</a> | <a href="/admin/settings">SETTINGS</a> | <a href="/admin/logout">LOGOUT</a>
    </nav>
</div>
<div class="container"><div class="main-content"><div class="dos-box"><div class="dos-title">EDIT POST</div>
<form action="/admin/posts/edit/<%= post.id %>" method="POST" enctype="multipart/form-data">
    <div><label>TITLE:</label><br><input type="text" name="title" value="<%= post.title %>" required style="width: 100%;"></div>
    <div><label>SLUG:</label><br><input type="text" name="slug" value="<%= post.slug %>" required style="width: 100%;"></div>
    <div><label>CATEGORY:</label><br><select name="category_id" style="width: 100%;"><option value="">None</option><% categories.forEach(cat => { %><option value="<%= cat.id %>" <%= post.category_id == cat.id ? 'selected' : '' %>><%= cat.name %></option><% }); %></select></div>
    <div><label>SUMMARY:</label><br><textarea name="summary" style="width: 100%; height: 60px;"><%= post.summary %></textarea></div>
    <div><label>CONTENT (MARKDOWN):</label><br><textarea name="content" required style="width: 100%; height: 300px;"><%= post.content %></textarea></div>
    <div><label>IMAGE:</label><br><input type="file" name="image"></div>
    <div><label>TAGS:</label><br><% tags.forEach(tag => { %><label><input type="checkbox" name="tags" value="<%= tag.id %>" <%= postTags.includes(tag.id) ? 'checked' : '' %>> <%= tag.name %></label><% }); %></div>
    <button type="submit">UPDATE POST</button>
</form>
</div></div></div>
<%- include('../../partials/footer') %>
