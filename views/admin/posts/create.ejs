<%- include('../../partials/header') %>
<div class="admin-header">
    <span>LOGGED IN AS: <%= user %></span>
    <nav>
        <a href="/admin">DASHBOARD</a> | <a href="/admin/posts">POSTS</a> | <a href="/admin/categories">CATEGORIES</a> | <a href="/admin/tags">TAGS</a> | <a href="/admin/pages">PAGES</a> | <a href="/admin/comments">COMMENTS</a> | <a href="/admin/settings">SETTINGS</a> | <a href="/admin/logout">LOGOUT</a>
    </nav>
</div>
<div class="container"><div class="main-content"><div class="dos-box"><div class="dos-title">CREATE POST</div>
<form action="/admin/posts/create" method="POST" enctype="multipart/form-data">
    <div><label>TITLE:</label><br><input type="text" name="title" required style="width: 100%;"></div>
    <div><label>SLUG:</label><br><input type="text" name="slug" required style="width: 100%;"></div>
    <div><label>CATEGORY:</label><br><select name="category_id" style="width: 100%;"><option value="">None</option><% categories.forEach(cat => { %><option value="<%= cat.id %>"><%= cat.name %></option><% }); %></select></div>
    <div><label>SUMMARY:</label><br><textarea name="summary" style="width: 100%; height: 60px;"></textarea></div>
    <div><label>CONTENT (MARKDOWN):</label><br><textarea name="content" required style="width: 100%; height: 300px;"></textarea></div>
    <div><label>IMAGE:</label><br><input type="file" name="image"></div>
    <div><label>TAGS:</label><br><% tags.forEach(tag => { %><label><input type="checkbox" name="tags" value="<%= tag.id %>"> <%= tag.name %></label><% }); %></div>
    <div><label>NEW TAGS (comma separated):</label><br><input type="text" name="new_tags" style="width: 100%;"></div>
    <button type="submit">SAVE POST</button>
</form>
</div></div></div>
<%- include('../../partials/footer') %>
